{
    "name": "scrybe",
    "version": "0.2.16",
    "private": false,
    "scripts": {
        "build": "vite build",
        "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
        "check": "pnpm paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && i18n-lint ./messages",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "preview": "vite preview",
        "tauri": "tauri",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:shared": "node --test --test-concurrency=1 utils/js/inbound/controller.test.mjs",
        "test:python": "uv run --locked pytest tests/python/unit tests/packaging --junitxml=target/test-results/python.xml",
        "test:rust": "cargo test --locked -p scrybe_core -p scrybe -p synth-tauri-runtime -p inbound -- --test-threads=1",
        "test:rust:build": "cargo test --locked -p scrybe_core -p scrybe -p synth-tauri-runtime -p inbound --no-run",
        "test:packaging": "node tests/packaging/run.mjs",
        "test:screenshots": "node --test tests/screenshots/tooling.test.mjs",
        "test:browser": "playwright test --config playwright.config.ts",
        "test:internal": "node internal/internal-test.mjs",
        "test:webkit": "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 .venv-native/bin/python -m pytest tests/python/webkit --junitxml=target/test-results/webkit.xml",
        "test:native": "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 .venv-native/bin/python -m pytest tests/python/native --junitxml=target/test-results/native.xml",
        "test:audio": "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 .venv-native/bin/python -m pytest tests/python/audio --junitxml=target/test-results/audio.xml",
        "test:inference": "uv run --locked pytest tests/python/inference --junitxml=target/test-results/inference.xml",
        "test:packaging:artifacts": "node tests/packaging/artifacts.mjs",
        "setup:inference-fixtures": "uv run --locked python -m tests.support.python.inference",
        "setup:vad": "uv run --locked python -m tests.support.python.models",
        "test": "pnpm test:unit && pnpm test:shared && pnpm test:screenshots && pnpm test:python && pnpm test:rust && pnpm test:packaging && pnpm test:browser && pnpm test:internal",
        "verify": "pnpm check && pnpm build && pnpm test && cargo fmt --all --check && git diff --check && git -C utils diff --check"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.18.2",
        "@lucide/svelte": "^1.17.0",
        "@playwright/test": "1.64.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.64.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@synthlabs/i18n": "link:utils\\js\\i18n",
        "@tailwindcss/vite": "^4.3.0",
        "@tauri-apps/cli": "^2.11.2",
        "@types/node": "^24.13.1",
        "bits-ui": "2.18.0",
        "clsx": "^2.1.1",
        "mode-watcher": "^1.1.0",
        "prettier": "^3.8.4",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "svelte-sonner": "^0.3.28",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.16",
        "vitest": "5.0.4"
    },
    "type": "module",
    "dependencies": {
        "@tauri-apps/api": "^2.11.0",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-log": "^2.8.0",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-store": "^2.4.3",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "tauri-svelte-synced-store": "github:synthlabs/tauri-svelte-synced-store"
    },
    "packageManager": "pnpm@10.26.1"
}
